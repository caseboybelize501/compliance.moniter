# =============================================================================
# ACMP Environment Configuration
# Open Source First - All proprietary APIs are optional/user-provided
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Generate encryption key
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# REQUIRED: Generate JWT secret
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=

# =============================================================================
# DATABASE CONFIGURATION
# Default: PostgreSQL (standalone)
# Alternative: Supabase (enable supabase profile in docker-compose)
# =============================================================================

# PostgreSQL (Default)
DATABASE_URL=postgresql://acmp:acmp_secret@localhost:5432/acmp

# Supabase (Optional - if using supabase profile)
# SUPABASE_URL=http://localhost:8000
# SUPABASE_KEY=your-supabase-anon-key

# =============================================================================
# STORAGE CONFIGURATION (Minio - S3 compatible)
# =============================================================================
MINIO_ACCESS_KEY=acmp_admin
MINIO_SECRET_KEY=change_this_secret_key

# =============================================================================
# LLM CONFIGURATION
# Default: vLLM (self-hosted, OpenAI-compatible API)
# Options: vllm, ollama, openai
# =============================================================================

# Provider selection
LLM_PROVIDER=vllm

# vLLM Configuration (Default - requires GPU)
LLM_API_BASE=http://localhost:8001/v1
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HUGGINGFACE_TOKEN=

# Ollama Configuration (CPU-friendly alternative)
# LLM_PROVIDER=ollama
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=mistral:7b

# OpenAI Configuration (Optional - user provides key)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here

# =============================================================================
# AUTHENTICATION CONFIGURATION
# Default: Keycloak (self-hosted)
# Alternative: Direct JWT, Okta, Azure AD (user provides credentials)
# =============================================================================

# Keycloak (Default)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=acmp
KEYCLOAK_CLIENT_ID=acmp-backend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Okta (Optional)
# OKTA_ISSUER=https://your-org.okta.com/oauth2/default
# OKTA_CLIENT_ID=your-client-id
# OKTA_CLIENT_SECRET=your-client-secret

# Azure AD (Optional)
# AZURE_AD_TENANT_ID=your-tenant-id
# AZURE_AD_CLIENT_ID=your-client-id
# AZURE_AD_CLIENT_SECRET=your-client-secret

# =============================================================================
# MESSAGING CONFIGURATION
# Default: WhatsApp (via Twilio - user provides credentials)
# Alternatives: Slack, Microsoft Teams
# =============================================================================

# Provider selection
MESSAGING_PROVIDER=whatsapp

# WhatsApp via Twilio (Default - user auths on their own)
# Sign up at https://twilio.com (free trial available)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Slack (Optional)
# MESSAGING_PROVIDER=slack
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# Microsoft Teams (Optional)
# MESSAGING_PROVIDER=teams
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# =============================================================================
# SOURCE CREDENTIALS (At least 1 cloud provider required)
# Users provide their own credentials for their infrastructure
# =============================================================================

# AWS (Recommended - read-only SecurityAudit policy)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP (Optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Azure (Optional)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# =============================================================================
# CODE REPOSITORY CONNECTORS (Optional)
# =============================================================================
GITHUB_TOKEN=
GITLAB_TOKEN=

# =============================================================================
# IDENTITY PROVIDER CONNECTORS (Optional)
# =============================================================================

# Okta (for MFA evidence - optional, separate from auth)
OKTA_API_TOKEN=
OKTA_ORG_URL=https://your-org.okta.com

# =============================================================================
# TICKETING (Optional)
# =============================================================================
JIRA_SERVER=https://your-instance.atlassian.net
JIRA_TOKEN=
JIRA_EMAIL=

LINEAR_API_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
LOG_LEVEL=INFO
ENVIRONMENT=development

# Redis
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# USAGE EXAMPLES
# =============================================================================
# 
# 1. Basic setup (PostgreSQL + Minio + Redis):
#    docker-compose up -d
#
# 2. With local LLM (vLLM - requires GPU):
#    docker-compose --profile llm up -d
#
# 3. With Keycloak authentication:
#    docker-compose --profile auth up -d
#
# 4. CPU-only LLM (Ollama instead of vLLM):
#    docker-compose --profile ollama up -d
#
# 5. Full stack with monitoring:
#    docker-compose --profile llm --profile auth --profile monitoring up -d
#
# 6. Using Supabase instead of PostgreSQL:
#    docker-compose --profile supabase up -d
# =============================================================================
